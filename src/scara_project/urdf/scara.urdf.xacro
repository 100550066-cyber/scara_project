<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara_bot">
 <xacro:macro name="scara_bot" params="parent_link: 'world' xyz: '0 0 0' rpy: '0 0 0'">
   
    <xacro:property name="j1_xyz" value="0 0 0.05"/>
    <xacro:property name="j1_2_xyz" value="0 0 0.2"/>
    <xacro:property name="j2_xyz" value="0.2 0 0.05"/>
    <xacro:property name="j22_3_xyz" value="0 0 0.05"/>
    <xacro:property name="j23_3_xyz" value="0.2 0 0.0"/>
    <xacro:property name="j3_xyz" value="0 0 0.11"/>



    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/> 
            <geometry>
                <box size="0.15 0.15 0.05"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
            </visual>
            <collision>
                <origin xyz="0 0 0.025" rpy="0 0 0"/>       
            <geometry>
                <box size="0.15 0.15 0.05"/>   
                </geometry>
            </collision>
    </link>

    <joint name="base_to_world" type="fixed">
        <parent link="${parent_link}"/>
        <child link="base_link"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="link_1">
        <visual>
            <origin xyz="0 0 0.2" rpy="0 0 0"/> 
            <geometry>
                <cylinder length="0.25" radius="0.05"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>       
            <geometry>
                <cylinder length="0.25" radius="0.05"/>   
                </geometry>
            </collision>
    </link>


    <joint name="joint_1" type="revolute">
        <axis xyz="0 0 1"/>
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="${j1_xyz}" rpy="0 0 0"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    </joint>

    <link name="link1_to_link2">
       <visual>
        <geometry>
            <box size= "0.1 0.1 0.2"/>
        </geometry>
        <origin xyz="0.1 0 0" rpy="0 1.571 0"/> 
        <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
       </visual>
       <collision>
        <origin xyz="0.1 0 0" rpy="0 1.571 0"/>       
            <geometry>
                <box size= "0.1 0.1 0.2"/>  
                </geometry> 
            </collision>
    </link>

   <joint name="fixed1" type="fixed">
        <parent link="link_1"/>
        <child link="link1_to_link2"/>
        <origin xyz="${j1_2_xyz}" rpy="0 0 0"/>
    </joint>


    <link name="link_2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/> 
            <geometry>
                <cylinder length="0.2" radius="0.05"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>       
            <geometry>
                <cylinder length="0.2" radius="0.05"/>  
                </geometry> 
            </collision>
    </link>

 <joint name="joint_2" type="revolute">
                <parent link="link1_to_link2"/>
                <child link="link_2"/>
                <origin xyz="${j2_xyz}" rpy="0 0 0"/>
                <axis xyz="0 0 1"/>
                <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
            </joint>
    
     <link name="link2_to_link3">
                <visual>
                    <geometry>
                        <box size= "0.1 0.1 0.2"/>
                    </geometry>
                    <origin xyz="0.1 0 0" rpy="0 1.571 0"/> 
                    <material name="blue">
                            <color rgba="0 0 1 1"/>
                        </material>
                </visual>
                <collision>
                    <origin xyz="0.1 0 0" rpy="0 1.571 0"/>       
                        <geometry>
                            <box size= "0.1 0.1 0.2"/>  
                            </geometry> 
                        </collision>
    </link>

 <joint name="fixed2" type="fixed">
                <parent link="link_2"/>
                <child link="link2_to_link3"/>
                <origin xyz="${j22_3_xyz}" rpy="0 0 0"/>
</joint>

    <link name="link_3">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.1" radius="0.15"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>       
            <geometry>
                <cylinder length="0.1" radius="0.15"/>   
                </geometry>
            </collision>
    </link>

    <joint name="fixed3" type="fixed">
        <parent link="link2_to_link3"/>
        <child link="link_3"/>
        <origin xyz="${j23_3_xyz}" rpy="3.14 0 0"/>
    </joint>

    <link name="link3_housing">
        <visual>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.5" radius="0.05"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>       
            <geometry>
                <cylinder length="0.5" radius="0.05"/>   
                </geometry>
            </collision>
    </link> 

 <joint name="joint_3" type="prismatic">
        <parent link="link_3"/>
        <child link="link3_housing"/>
        <origin xyz="${j3_xyz}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.3" effort="1000" velocity="0.1"/>
    </joint>

 </xacro:macro>

 
 </robot>
